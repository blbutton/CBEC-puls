<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mars.boot4.mallarticlesummary.news.infrastructure.persistence.NewsMapper">

    <resultMap id="BaseResultMap" type="com.mars.boot4.mallarticlesummary.news.domain.model.News">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="summary" property="summary"/>
        <result column="content" property="content"/>
        <result column="cover_image" property="coverImage"/>
        <result column="source" property="source"/>
        <result column="author" property="author"/>
        <result column="category" property="category"/>
        <result column="view_count" property="viewCount"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="is_top" property="isTop"/>
        <result column="publish_time" property="publishTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, title, summary, content, cover_image, source, author, category,
        view_count, sort, status, is_top, publish_time, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.mars.boot4.mallarticlesummary.news.domain.model.News" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO art_news (title, summary, content, cover_image, source, author, category,
                              view_count, sort, status, is_top, publish_time, create_time, update_time)
        VALUES (#{title}, #{summary}, #{content}, #{coverImage}, #{source}, #{author}, #{category},
                #{viewCount}, #{sort}, #{status}, #{isTop}, #{publishTime},
                COALESCE(#{createTime}, CURRENT_TIMESTAMP),
                COALESCE(#{updateTime}, CURRENT_TIMESTAMP))
    </insert>

    <update id="updateByPrimaryKeySelective" parameterType="com.mars.boot4.mallarticlesummary.news.domain.model.News">
        UPDATE art_news
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="content != null">content = #{content},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="source != null">source = #{source},</if>
            <if test="author != null">author = #{author},</if>
            <if test="category != null">category = #{category},</if>
            <if test="viewCount != null">view_count = #{viewCount},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="isTop != null">is_top = #{isTop},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        DELETE FROM art_news WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM art_news WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap" parameterType="java.lang.Long">
        SELECT <include refid="Base_Column_List"/> FROM art_news WHERE id = #{id}
    </select>

    <select id="selectListByPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM art_news
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%') OR summary LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY is_top DESC, sort ASC, id DESC
    </select>

    <update id="updateStatusByIds">
        UPDATE art_news SET status = #{status} WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>
