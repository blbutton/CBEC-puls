# ====== 数据库 ======
# 生产环境使用 MySQL 8.0+
DATABASE_URL="mysql+pymysql://root:your_password@127.0.0.1:3306/global_news?charset=utf8mb4"

# 开发/演示环境可切换为 SQLite（零配置开箱即用）
# DATABASE_URL="sqlite:///./global_news.db"

# ====== 调度间隔（秒）======
SCHEDULE_NEWS_INTERVAL=1800       # 30 分钟
SCHEDULE_PAPERS_INTERVAL=21600    # 6 小时
SCHEDULE_SOCIAL_INTERVAL=600      # 10 分钟

# ====== 爬虫节流（秒/次）======
CRAWL_NEWS_DELAY=1
CRAWL_PAPER_DELAY=3
CRAWL_SOCIAL_DELAY=1

# ====== 可选 API Key（未配置则自动降级）======
# IEEE Xplore
IEEE_API_KEY=""
# Springer Nature
SPRINGER_API_KEY=""
# NewsAPI.org
NEWS_API_KEY=""
# GNews
GNEWS_API_KEY=""

# ====== 安全 ======
# API 手动触发时的 Token（请求头 X-Crawl-Token）
CRAWL_TRIGGER_TOKEN="change-me-please"

# ====== 日志 ======
LOG_LEVEL="INFO"
LOG_DIR="./logs"

# ====== 时区 ======
TIMEZONE="Asia/Shanghai"
